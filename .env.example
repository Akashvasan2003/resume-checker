# Copy this file to .env and fill in values as needed.

# Optional: enables LLM-assisted project-quality scoring.
# When set, the OpenAI API is called once per eligible candidate to refine
# the AI project depth score.  If the key is absent or the call fails, the
# system falls back to fully deterministic scoring automatically.
OPENAI_API_KEY=

# Optional: raises the GitHub API rate limit from 60 to 5000 req/hour.
GITHUB_TOKEN=

# Optional: set to 1 / true / yes to skip GitHub enrichment entirely.
DISABLE_GITHUB_ENRICHMENT=
